{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BatteryLake dataset metadata",
  "description": "One record per dataset, built from Raw_Dataset (its measurement files and author documentation) with the registry, landing pages and papers as fallbacks. Dataset-level fields hold the aggregate across all entities; cells[] carries per-entity overrides only where an entity differs from the dataset value. Missing information is null, never a placeholder string.",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "identity",
    "cell",
    "conditions",
    "scale",
    "content",
    "cells",
    "quality",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^dataset_[A-Za-z0-9_]+$"
    },
    "identity": {
      "type": "object",
      "required": [
        "ref_name",
        "ref_name_aliases",
        "dataset_name",
        "institution",
        "year",
        "doi",
        "source_url",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "ref_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref_name_aliases": {
          "description": "Every other name this dataset has gone by, kept so old references still resolve. ref_name is the corrected name.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "status",
              "seen_in"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "historical",
                  "mismatched"
                ]
              },
              "seen_in": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "registry_history",
                    "raw_readme"
                  ]
                }
              }
            }
          }
        },
        "dataset_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "institution": {
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1990,
          "maximum": 2100
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "paper_doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "study_group": {
          "description": "The study-group label source_relationships.json assigns this dataset, if it appears there - a hand-maintained note of which datasets share an upstream study, independent of whether their raw cell ids overlap. Null if the dataset is not in that file.",
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "description": "A one-line description in the registry's style: count, chemistry and format of what the raw data delivers, a few facts about the tests, and the linked paper. Composed by build.py from this record's own fields plus curated detail clauses. Not the same as quality.notes, which records caveats and source conflicts for people working with the data.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "cell": {
      "type": "object",
      "required": [
        "cathode_chemistries",
        "anode_chemistries",
        "form_factors",
        "nominal_capacity_Ah",
        "voltage_min_V",
        "voltage_max_V"
      ],
      "additionalProperties": false,
      "properties": {
        "manufacturer": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "chemistry_label_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "chemistry_is_multi": {
          "type": "boolean"
        },
        "dimensions_mm": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "diameter": {
              "type": [
                "number",
                "null"
              ]
            },
            "height": {
              "type": [
                "number",
                "null"
              ]
            },
            "length": {
              "type": [
                "number",
                "null"
              ]
            },
            "width": {
              "type": [
                "number",
                "null"
              ]
            },
            "thickness": {
              "type": [
                "number",
                "null"
              ]
            },
            "basis": {
              "enum": [
                "stated",
                "inferred_from_format_code",
                null
              ]
            }
          }
        },
        "nominal_capacity_Ah": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "capacity_basis": {
          "enum": [
            "rated",
            "measured",
            null
          ]
        },
        "nominal_voltage_V": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "voltage_level": {
          "enum": [
            "cell",
            "pack",
            null
          ]
        },
        "voltage_min_V": {
          "type": [
            "number",
            "null"
          ]
        },
        "voltage_max_V": {
          "type": [
            "number",
            "null"
          ]
        },
        "form_factors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/form_factor"
          },
          "description": "Every form factor present in the dataset, sorted."
        },
        "cell_format_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every cell size code present (18650, 21700, 26650, 502030 ...), sorted; empty when none is documented."
        },
        "cathode_chemistries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cathode"
          },
          "description": "Every cathode chemistry present, sorted; empty when none is documented."
        },
        "anode_chemistries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anode"
          },
          "description": "Every anode chemistry present, sorted; empty when none is documented."
        },
        "electrode_combinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cathode",
              "anode"
            ],
            "properties": {
              "cathode": {
                "$ref": "#/$defs/cathode"
              },
              "anode": {
                "$ref": "#/$defs/anode"
              }
            }
          },
          "description": "Cathode-anode pairs present together on the same cells; pairs with an undocumented electrode are left out."
        },
        "nominal_capacities_Ah": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Every nominal capacity present as a discrete value, sorted ascending."
        }
      }
    },
    "conditions": {
      "type": "object",
      "required": [
        "temperature_min_C",
        "temperature_max_C",
        "temperature_basis",
        "protocol_class",
        "aging_type",
        "application_domain"
      ],
      "additionalProperties": false,
      "properties": {
        "temperature_min_C": {
          "type": [
            "number",
            "null"
          ]
        },
        "temperature_max_C": {
          "type": [
            "number",
            "null"
          ]
        },
        "temperature_setpoints_C": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "temperature_basis": {
          "enum": [
            "chamber_setpoint",
            "measured",
            "onset",
            "unspecified",
            null
          ]
        },
        "charge_c_rate_max": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "discharge_c_rate_max": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "c_rate_profile": {
          "enum": [
            "constant",
            "multistage",
            "dynamic",
            "drive_cycle",
            "none",
            null
          ]
        },
        "protocol_class": {
          "$ref": "#/$defs/protocol_class"
        },
        "charging_profile": {
          "$ref": "#/$defs/charging_profile"
        },
        "protocol_charge_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol_discharge_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "soc_window_min_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "soc_window_max_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "aging_type": {
          "$ref": "#/$defs/aging_type"
        },
        "application_domain": {
          "$ref": "#/$defs/application_domain"
        },
        "profile_combinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "charge",
              "discharge"
            ],
            "properties": {
              "charge": {
                "$ref": "#/$defs/charge_profile_type"
              },
              "discharge": {
                "$ref": "#/$defs/discharge_profile_type"
              }
            }
          },
          "description": "Charging and discharging profile types that are applied together. Together with single_side_profiles this is the full list of profiles of the dataset."
        },
        "single_side_profiles": {
          "type": "array",
          "description": "Profiles that belong to no charge/discharge pair because the dataset (or the part of it that uses the profile) has data on one side only, such as charging snippets from a vehicle or discharge-only tests. Each entry names the side and the profile. Empty when every profile is in a pair. The display label (\"CC Charging\") and the per-dataset lists of charge and discharge profiles are not stored: readers derive them from profile_combinations and these entries.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "side",
              "profile"
            ],
            "properties": {
              "side": {
                "enum": [
                  "charge",
                  "discharge"
                ]
              },
              "profile": {
                "type": "string"
              }
            }
          }
        },
        "dynamic_subprofiles": {
          "type": "array",
          "description": "The named profiles inside the dynamic type: standard drive cycles (UDDS, WLTP, US06), recorded real driving, duty cycles of an application (an eVTOL mission, grid-storage peak shaving) and a square wave. Filled for every dataset that has a dynamic profile and empty otherwise. kind groups them: drive_cycle, real_driving, duty_cycle or square_wave. detail is free text (parameters, which cells) or null. Dynamic stays one profile type; this list says what it consists of.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind",
              "detail"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "drive_cycle",
                  "real_driving",
                  "duty_cycle",
                  "square_wave"
                ]
              },
              "detail": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "rate_combinations": {
          "type": "array",
          "description": "C-rates stated for the profiles of the dataset, as one list of rows. A row belongs to one charge/discharge pair of profile_combinations, or to one profile of single_side_profiles (the other side's profile is then null). charge_c_rate is the constant-current stage; a rate is null where no source gives it for that side, for example a dynamic or multi-stage side. Rows are not a cross product: when several rates face several rates on the other side and the source does not say which meets which, each side has rows of its own with the other rate null.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "charge_profile",
              "charge_c_rate",
              "discharge_profile",
              "discharge_c_rate"
            ],
            "properties": {
              "charge_profile": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/charge_profile_type"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "charge_c_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "discharge_profile": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/discharge_profile_type"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "discharge_c_rate": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "charge_c_rate_fraction": {
                "type": "string",
                "pattern": "^[0-9]+/[0-9]+$",
                "description": "Exact fraction of 1C for charge_c_rate; present only when the source writes it as a fraction."
              },
              "discharge_c_rate_fraction": {
                "type": "string",
                "pattern": "^[0-9]+/[0-9]+$",
                "description": "Exact fraction of 1C for discharge_c_rate; present only when the source writes it as a fraction."
              },
              "charge_subprofile": {
                "type": "string",
                "description": "Name of the dynamic_subprofiles entry this row's charge side runs; present only when charge_profile is dynamic."
              },
              "discharge_subprofile": {
                "type": "string",
                "description": "Name of the dynamic_subprofiles entry this row's discharge side runs (for example Square wave or UDDS); present only when discharge_profile is dynamic. A frontend shows it in place of the word Dynamic."
              }
            }
          }
        },
        "charge_c_rate_max_fraction": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+/[0-9]+$",
          "description": "Exact fraction of 1C (for example 1/3 or 5/3) when the source writes the rate as a fraction and the decimal recurs; null otherwise. A frontend shows this as C/3 or 5C/3 when it is present and the decimal when it is not."
        },
        "discharge_c_rate_max_fraction": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+/[0-9]+$",
          "description": "Exact fraction of 1C (for example 1/3 or 5/3) when the source writes the rate as a fraction and the decimal recurs; null otherwise. A frontend shows this as C/3 or 5C/3 when it is present and the decimal when it is not."
        }
      }
    },
    "scale": {
      "type": "object",
      "required": [
        "entity_type",
        "n_entities",
        "n_entities_declared",
        "n_raw_files",
        "raw_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "entity_type": {
          "enum": [
            "cell",
            "module",
            "pack",
            "vehicle"
          ]
        },
        "n_entities": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "n_entities_declared": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "n_cycles_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cycles_per_entity_median": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "n_raw_files": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "raw_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "content": {
      "type": "object",
      "required": [
        "signals",
        "has_waveforms",
        "source_format",
        "supported_tasks"
      ],
      "additionalProperties": false,
      "properties": {
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signal"
          }
        },
        "signals_basis": {
          "enum": [
            "raw_data",
            "raw_docs",
            "landing_page",
            "paper",
            "curated",
            null
          ]
        },
        "raw_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "has_waveforms": {
          "type": "boolean"
        },
        "cycle_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "count_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "voltage_V": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "current_A": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "temperature_C": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "discharge_capacity_Ah_max": {
              "type": [
                "number",
                "null"
              ]
            },
            "discharge_capacity_Ah_median_of_entity_max": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "source_format": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supported_tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cell_id"
        ],
        "additionalProperties": false,
        "properties": {
          "cell_id": {
            "type": "string",
            "minLength": 1
          },
          "manufacturer": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "cathode_chemistry": {
            "$ref": "#/$defs/cathode"
          },
          "anode_chemistry": {
            "$ref": "#/$defs/anode"
          },
          "form_factor": {
            "$ref": "#/$defs/form_factor"
          },
          "nominal_capacity_Ah": {
            "type": [
              "number",
              "null"
            ]
          },
          "nominal_voltage_V": {
            "type": [
              "number",
              "null"
            ]
          },
          "voltage_min_V": {
            "type": [
              "number",
              "null"
            ]
          },
          "voltage_max_V": {
            "type": [
              "number",
              "null"
            ]
          },
          "temperature_C": {
            "type": [
              "number",
              "null"
            ]
          },
          "protocol_charge_raw": {
            "type": [
              "string",
              "null"
            ]
          },
          "protocol_discharge_raw": {
            "type": [
              "string",
              "null"
            ]
          },
          "labels": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "flags"
      ],
      "additionalProperties": false,
      "properties": {
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "field_sources",
        "confidence",
        "last_verified"
      ],
      "additionalProperties": false,
      "properties": {
        "field_sources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/source"
          }
        },
        "confidence": {
          "enum": [
            "verified",
            "asserted",
            "inferred"
          ]
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        },
        "raw_evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "landing_evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "cathode": {
      "enum": [
        "LFP",
        "NMC",
        "NMC811",
        "NCA",
        "LCO",
        "LMO",
        "LTO",
        "NMC-LMO",
        "LMO-LNO",
        "LCO-NCO",
        "LCO-NMC",
        "mixed",
        null
      ]
    },
    "anode": {
      "enum": [
        "graphite",
        "Si-graphite",
        "LTO",
        "mixed",
        null
      ]
    },
    "form_factor": {
      "enum": [
        "cylindrical",
        "pouch",
        "prismatic",
        "module",
        "pack",
        null
      ]
    },
    "charging_profile": {
      "enum": [
        "CC-CV",
        "dynamic",
        "multi-rate",
        null
      ]
    },
    "protocol_class": {
      "enum": [
        "CC-CV",
        "multistage_CC",
        "drive_cycle",
        "calendar_hold",
        "pulse",
        "RPT_only",
        "abuse",
        "mixed",
        null
      ]
    },
    "aging_type": {
      "enum": [
        "cyclic",
        "calendar",
        "profile",
        "second_life",
        "abuse_mechanical",
        "abuse_thermal",
        "field",
        "characterization",
        "mixed",
        null
      ]
    },
    "application_domain": {
      "enum": [
        "lab",
        "EV_field",
        "HEV",
        "eVTOL",
        "grid_storage",
        "safety",
        "consumer",
        null
      ]
    },
    "signal": {
      "enum": [
        "time",
        "voltage",
        "current",
        "temperature",
        "charge_capacity",
        "discharge_capacity",
        "capacity",
        "internal_resistance",
        "soh",
        "rul",
        "step_type",
        "cycle_index",
        "force",
        "displacement",
        "eis",
        "soc",
        "ocv",
        "power",
        "energy"
      ]
    },
    "task": {
      "enum": [
        "SOH",
        "RUL",
        "SOC",
        "anomaly",
        "fault_diagnosis",
        "thermal_safety",
        "characterization"
      ]
    },
    "source": {
      "enum": [
        "raw_data",
        "raw_filenames",
        "raw_docs",
        "raw_inventory",
        "registry",
        "landing_page",
        "paper",
        "relationships",
        "datasheet",
        "curated",
        "ref_name",
        "derived"
      ]
    },
    "flag": {
      "enum": [
        "multi_chemistry",
        "capacity_exceeds_nominal",
        "voltage_excursion_below_cutoff",
        "voltage_excursion_above_cutoff",
        "pack_level_voltage",
        "temperature_basis_differs_from_data",
        "partial_raw",
        "incomplete_raw_files",
        "unreadable_raw_files",
        "sample_only_raw",
