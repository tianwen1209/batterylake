{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BatteryLake research profile index",
  "description": "Generated by metadata/scripts/generate/build_research.py. One flat, filterable row per dataset summarizing metadata/research/dataset_NN.json, plus precomputed facet vocabularies. Filter on datasets, then open a record through record_path when the full profile is needed. Never edit by hand: edit build_research.py and rebuild.",
  "type": "object",
  "required": [
    "schema_version",
    "generated",
    "record_schema",
    "count",
    "facets",
    "datasets"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "generated": {
      "type": "string",
      "format": "date"
    },
    "record_schema": {
      "type": "string"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "facets": {
      "type": "object",
      "description": "field name -> sorted list of every value present across the rows (list-valued fields such as suitable_tasks are flattened), for building filter UI without scanning the rows",
      "required": [
        "category",
        "suitable_tasks",
        "source_confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suitable_tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/suitable_task"
          }
        },
        "source_confidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "dataset_id",
          "category",
          "record_path",
          "complete_v_i_t_timeseries",
          "soc_computable",
          "soh_computable",
          "capacity_degradation_present",
          "ocv_present",
          "internal_resistance_present",
          "eis_present",
          "thermal_characterization",
          "suitable_tasks",
          "source_confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "dataset_id": {
            "type": "string",
            "pattern": "^dataset_[A-Za-z0-9_]+$"
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "record_path": {
            "type": "string",
            "pattern": "^research/dataset_[A-Za-z0-9_]+\\.json$"
          },
          "complete_v_i_t_timeseries": {
            "type": "boolean"
          },
          "soc_computable": {
            "type": "boolean"
          },
          "soh_computable": {
            "type": "boolean"
          },
          "capacity_degradation_present": {
            "type": "boolean"
          },
          "ocv_present": {
            "type": "boolean"
          },
          "internal_resistance_present": {
            "type": "boolean"
          },
          "eis_present": {
            "type": "boolean"
          },
          "thermal_characterization": {
            "type": "boolean"
          },
          "suitable_tasks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/suitable_task"
            }
          },
          "source_confidence": {
            "enum": [
              "verified",
              "asserted",
              "inferred",
              null
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "suitable_task": {
      "enum": [
        "SOH_estimation",
        "RUL_prediction",
        "SOC_estimation",
        "digital_twin_calibration",
        "thermal_modelling",
        "simulation",
        "synthetic_data_generation",
        "EIS_characterization",
        "OCV_curve_extraction",
        "fault_diagnosis"
      ]
    }
  }
}