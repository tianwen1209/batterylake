{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BatteryLake global metadata index",
  "description": "Generated by metadata/scripts/generate/build.py. One flat row per dataset for filtering, plus precomputed facet vocabularies. Never edit by hand: edit a dataset record or the curation file and rebuild.",
  "type": "object",
  "required": [
    "schema_version",
    "content_hash",
    "generated",
    "record_schema",
    "counts",
    "facets",
    "datasets"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "content_hash": {
      "type": "string",
      "description": "sha256 over the dataset rows, so two copies of this file can detect whether their underlying data has diverged."
    },
    "generated": {
      "type": "string",
      "format": "date"
    },
    "record_schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "facets": {
      "type": "object",
      "description": "field name -> sorted list of every value present, for building filter UI without scanning the rows",
      "additionalProperties": {
        "type": "array"
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "dataset_id",
          "record_path",
          "n_entities",
          "has_waveforms"
        ],
