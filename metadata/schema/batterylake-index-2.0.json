{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BatteryLake global metadata index",
  "description": "Generated by metadata/scripts/generate/build.py. One flat row per dataset for filtering, plus precomputed facet vocabularies. Never edit by hand: edit a dataset record or the curation file and rebuild.",
  "type": "object",
  "required": [
    "schema_version",
    "content_hash",
    "generated",
    "record_schema",
    "counts",
    "facets",
    "datasets"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "content_hash": {
      "type": "string",
      "description": "sha256 over the dataset rows, so two copies of this file can detect whether their underlying data has diverged."
    },
    "generated": {
      "type": "string",
      "format": "date"
    },
    "record_schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "facets": {
      "type": "object",
      "description": "field name -> sorted list of every value present, for building filter UI without scanning the rows",
      "additionalProperties": {
        "type": "array"
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "dataset_id",
          "record_path",
          "n_entities",
          "has_waveforms"
        ],
        "properties": {
          "dataset_id": {
            "type": "string"
          },
          "record_path": {
            "type": "string",
            "pattern": "^datasets/dataset_[A-Za-z0-9_]+\\.json$"
          },
          "ref_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "ref_name_aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dataset_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "institution": {
            "type": [
              "string",
              "null"
            ]
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "manufacturer": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "chemistry_is_multi": {
            "type": "boolean"
          },
          "nominal_capacity_Ah": {
            "type": [
              "number",
              "null"
            ]
          },
          "nominal_voltage_V": {
            "type": [
              "number",
              "null"
            ]
          },
          "voltage_min_V": {
            "type": [
              "number",
              "null"
            ]
          },
          "voltage_max_V": {
            "type": [
              "number",
              "null"
            ]
          },
          "temperature_min_C": {
            "type": [
              "number",
              "null"
            ]
          },
          "temperature_max_C": {
            "type": [
              "number",
              "null"
            ]
          },
          "charge_c_rate_max": {
            "type": [
              "number",
              "null"
            ]
          },
          "discharge_c_rate_max": {
            "type": [
              "number",
              "null"
            ]
          },
          "c_rate_profile": {
            "type": [
              "string",
              "null"
            ]
          },
          "protocol_class": {
            "type": [
              "string",
              "null"
            ]
          },
          "charging_profile": {
            "enum": [
              "CC-CV",
              "dynamic",
              "multi-rate",
              null
            ]
          },
          "aging_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "application_domain": {
            "type": [
              "string",
              "null"
            ]
          },
          "entity_type": {
            "type": "string"
          },
          "n_entities": {
            "type": [
              "integer",
              "null"
            ]
          },
          "n_cycles_total": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cycles_per_entity_median": {
            "type": [
              "number",
              "null"
            ]
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supported_tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_format": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quality_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "verified",
              "asserted",
              "inferred"
            ]
          },
          "n_entities_declared": {
            "type": [
              "integer",
              "null"
            ]
          },
          "n_raw_files": {
            "type": [
              "integer",
              "null"
            ]
          },
          "raw_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "has_waveforms": {
            "type": "boolean"
          },
          "notes": {
            "description": "identity.notes of the record: the registry-style one-line description.",
            "type": [
              "string",
              "null"
            ]
          },
          "form_factors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cell_format_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cathode_chemistries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "anode_chemistries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "electrode_combinations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cathode",
                "anode"
              ],
              "properties": {
                "cathode": {
                  "$ref": "#/$defs/cathode"
                },
                "anode": {
                  "$ref": "#/$defs/anode"
                }
              }
            },
            "description": "Copied unchanged from the record: Cathode-anode pairs present together on the same cells; pairs with an undocumented electrode are left out."
          },
          "nominal_capacities_Ah": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "charge_profiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "discharge_profiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "profile_combinations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "charge",
                "discharge"
              ],
              "properties": {
                "charge": {
                  "$ref": "#/$defs/charge_profile_type"
                },
                "discharge": {
                  "$ref": "#/$defs/discharge_profile_type"
                }
              }
            },
            "description": "Copied unchanged from the record: Charging and discharging profile types that are applied together. Together with single_side_profiles this is the full list of profiles of the dataset."
          },
          "single_side_profiles": {
            "type": "array",
            "description": "Copied unchanged from the record: Profiles that belong to no charge/discharge pair because the dataset (or the part of it that uses the profile) has data on one side only, such as charging snippets from a vehicle or discharge-only tests. Each entry names the side and the profile. Empty when every profile is in a pair. The display label (\"CC Charging\") and the per-dataset lists of charge and discharge profiles are not stored: readers derive them from profile_combinations and these entries.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "side",
                "profile"
              ],
              "properties": {
                "side": {
                  "enum": [
                    "charge",
                    "discharge"
                  ]
                },
                "profile": {
                  "type": "string"
                }
              }
            }
          },
          "dynamic_subprofiles": {
            "type": "array",
            "description": "Copied unchanged from the record: The named profiles inside the dynamic type: standard drive cycles (UDDS, WLTP, US06), recorded real driving, duty cycles of an application (an eVTOL mission, grid-storage peak shaving) and a square wave. Filled for every dataset that has a dynamic profile and empty otherwise. kind groups them: drive_cycle, real_driving, duty_cycle or square_wave. detail is free text (parameters, which cells) or null. Dynamic stays one profile type; this list says what it consists of.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "kind",
                "detail"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "drive_cycle",
                    "real_driving",
                    "duty_cycle",
                    "square_wave"
                  ]
                },
                "detail": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "rate_combinations": {
            "type": "array",
            "description": "Copied unchanged from the record: C-rates stated for the profiles of the dataset, as one list of rows. A row belongs to one charge/discharge pair of profile_combinations, or to one profile of single_side_profiles (the other side's profile is then null). charge_c_rate is the constant-current stage; a rate is null where no source gives it for that side, for example a dynamic or multi-stage side. Rows are not a cross product: when several rates face several rates on the other side and the source does not say which meets which, each side has rows of its own with the other rate null.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "charge_profile",
                "charge_c_rate",
                "discharge_profile",
                "discharge_c_rate"
              ],
              "properties": {
                "charge_profile": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/charge_profile_type"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "charge_c_rate": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0
                },
                "discharge_profile": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/discharge_profile_type"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "discharge_c_rate": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0
                },
                "charge_c_rate_fraction": {
                  "type": "string",
                  "pattern": "^[0-9]+/[0-9]+$",
                  "description": "Exact fraction of 1C for charge_c_rate; present only when the source writes it as a fraction."
                },
                "discharge_c_rate_fraction": {
                  "type": "string",
                  "pattern": "^[0-9]+/[0-9]+$",
                  "description": "Exact fraction of 1C for discharge_c_rate; present only when the source writes it as a fraction."
                },
                "charge_subprofile": {
                  "type": "string",
                  "description": "Name of the dynamic_subprofiles entry this row's charge side runs; present only when charge_profile is dynamic."
                },
                "discharge_subprofile": {
                  "type": "string",
                  "description": "Name of the dynamic_subprofiles entry this row's discharge side runs (for example Square wave or UDDS); present only when discharge_profile is dynamic. A frontend shows it in place of the word Dynamic."
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "cathode": {
      "enum": [
        "LFP",
        "NMC",
        "NMC811",
        "NCA",
        "LCO",
        "LMO",
        "LTO",
        "NMC-LMO",
        "LMO-LNO",
        "LCO-NCO",
        "LCO-NMC",
        "mixed",
        null
      ]
    },
    "anode": {
      "enum": [
        "graphite",
        "Si-graphite",
        "LTO",
        "mixed",
        null
      ]
    },
    "charge_profile_type": {
      "type": "string",
      "enum": [
        "CC",
        "CC-CV",
        "multi-stage CC",
        "multi-stage CC-CV",
        "pulse",
        "dynamic"
      ],
      "description": "How the cell is charged: constant current; constant current then constant voltage; several constant-current stages (without or with the final constant-voltage phase); pulses; or a time-varying current or power profile."
    },
    "discharge_profile_type": {
      "type": "string",
      "enum": [
        "CC",
        "CC-CV",
        "multi-stage CC",
        "pulse",
        "dynamic"
      ],
      "description": "How the cell is discharged: constant current; constant current then constant voltage; several constant-current stages; pulses; or a time-varying current or power profile (drive cycle, duty cycle, mission)."
    }
  }
}
