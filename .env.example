# Copy this file to .env and fill in your real key.
# Do not commit .env to GitHub.

AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Other providers for the local app.py backend:
#   AI_PROVIDER=openai        + AI_API_KEY, AI_API_URL (any OpenAI-compatible /chat/completions URL), AI_MODEL
#   AI_PROVIDER=pollinations  (free anonymous model, no key; availability varies)
# The website itself never reads this file. For the hosted GitHub Pages site,
# configure js/ai-config.js instead (see HOW_TO_RUN.md, "AI assistant").
